{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "scheme": "tezosx",
    "version": "0.7.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tezosx.walletmobile",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Tezos X uses Face ID to unlock your wallet and confirm transfers."
      }
    },
    "android": {
      "package": "com.tezosx.walletmobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Tezos X uses the camera to scan a dApp's WalletConnect QR code.",
          "barcodeScannerEnabled": true,
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "react-native-quick-crypto",
      "expo-build-properties"
    ]
  }
}
